# Plantilla de variables del backend. Copiar a .env y completar.
# Nunca versionar el archivo .env real.

DB_URL=jdbc:postgresql://localhost:5432/portal_escolar
DB_USERNAME=portal_app
DB_PASSWORD=cambiar_en_local

# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_una_clave_de_al_menos_32_bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_UPLOAD_DIR=./uploads

INSTITUTION_NAME=Portal Escolar
APP_DEMO_ENABLED=true
APP_DEMO_PASSWORD=cambiar_en_local
